  "description": "Control trivum multiroom audio systems from ioBroker",
  "author": {
    "name": "TheBam",
    "email": "elektrobam@gmx.de"
  },
  "homepage": "https://github.com/TheBam1990/ioBroker.trivum",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "trivum",
    "multiroom",
    "audio"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TheBam1990/ioBroker.trivum"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "axios": "^1.16.0",
    "xml-js": "^1.6.11"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^5.3.0",
