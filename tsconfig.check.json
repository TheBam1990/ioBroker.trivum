// Specialized tsconfig for type-checking js files
{
	"extends": "./tsconfig.json",
	"compilerOptions": {},
	"include": [
    "main.js",
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "test/**/*.js",
    "main.test.js"
	],
	"exclude": [
		"**/build",
		"node_modules/",
		"widgets/",
		"gulpfile.js"
	]
}
